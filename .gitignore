# Installs and build output never belong in the repository.
node_modules/
.next/
.turbopack/
coverage/
*.log

# What the app keeps for the people using it: their records in .data/app.db and
# their photos and files in .data/files/.
.data/
.tellop/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local verification records contain machine paths and save-backup references.
# Product specifications and implementation plans remain in the repository.
plans/*-baseline.json
plans/*-report.md

# Private values are never written into a file: the app refuses to start while
# one of these exists (lib/guard-no-plaintext-secrets.mjs).
.env
.env.*
.envrc
.npmrc
.netrc

.DS_Store
Thumbs.db
